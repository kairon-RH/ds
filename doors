	local EnvGroup = Tabs.Environment:AddLeftGroupbox("Lighting")
	local EnvGroup2 = Tabs.Environment:AddRightGroupbox("Debug Info")
	local EnvGroup3 = Tabs.Environment:AddLeftGroupbox("Room Controls")

	local fullbrightActive = false
	local fullbrightConn

	EnvGroup:AddToggle("Fullbright", {
		Text = "Fullbright",
		Default = false,
		Callback = function(v)
			fullbrightActive = v
			if fullbrightConn then
				fullbrightConn:Disconnect()
				fullbrightConn = nil
			end
			if v then
				fullbrightConn = RunService.Heartbeat:Connect(function()
					if not fullbrightActive then return end
					Lighting.Ambient = Color3.fromRGB(255, 255, 255)
					Lighting.Brightness = 2
					Lighting.FogEnd = 1e10
					Lighting.GlobalShadows = false
				end)
			else
				Lighting.Ambient = Color3.fromRGB(67, 51, 56)
				Lighting.Brightness = 0
				Lighting.FogEnd = 9999
				Lighting.GlobalShadows = true
			end
		end,
	})

	EnvGroup:AddSlider("BrightnessSlider", {
		Text = "Brightness",
		Default = 0,
		Min = 0,
		Max = 10,
		Rounding = 1,
		Callback = function(v)
			Lighting.Brightness = v
		end,
	})

	EnvGroup:AddSlider("FogSlider", {
		Text = "Fog End",
		Default = 9999,
		Min = 10,
		Max = 10000,
		Rounding = 1,
		Callback = function(v)
			Lighting.FogEnd = v
		end,
	})

	local coordLabel = EnvGroup2:AddLabel("Pos: 0, 0, 0")
	local roomLabel = EnvGroup2:AddLabel("Room: Unknown")

	RunService.Heartbeat:Connect(function()
		if rootPart then
			local p = rootPart.Position
			coordLabel:SetText(string.format("Pos: %.1f, %.1f, %.1f", p.X, p.Y, p.Z))
		end
		local gd = game:GetService("ReplicatedStorage"):FindFirstChild("GameData")
		if gd then
			local lr = gd:FindFirstChild("LatestRoom")
			if lr then
				roomLabel:SetText("Current Room: " .. tostring(lr.Value))
			end
		end
	end)

	EnvGroup2:AddButton({
		Text = "Print Workspace Tree",
		Func = function()
			for _, v in ipairs(workspace:GetChildren()) do
				print(v.Name, v.ClassName)
			end
			Library:Notify({ Title = "Rivo Hub", Content = "Workspace printed to output.", Duration = 3 })
		end,
	})

	EnvGroup3:AddButton({
		Text = "Destroy Puzzle Doors",
		Func = function()
			local currentRooms = workspace:FindFirstChild("CurrentRooms")
			if currentRooms then
				for _, v in ipairs(currentRooms:GetDescendants()) do
					if v:IsA("Model") and v.Name == "Gate" then
						v:Destroy()
					end
				end
			end
			Library:Notify({ Title = "Rivo Hub", Content = "Gates destroyed.", Duration = 3 })
		end,
	})

	EnvGroup3:AddButton({
		Text = "Spawn Debug Room",
		Func = function()
			local remote = game:GetService("ReplicatedStorage"):FindFirstChild("SpawnDebugRoom", true)
			if remote then
				remote:FireServer()
				Library:Notify({ Title = "Rivo Hub", Content = "Debug room spawned.", Duration = 3 })
			else
				Library:Notify({ Title = "Rivo Hub", Content = "Remote not found.", Duration = 3 })
			end
		end,
	})

	EnvGroup3:AddButton({
		Text = "Reset Room",
		Func = function()
			local remote = game:GetService("ReplicatedStorage"):FindFirstChild("ResetRoom", true)
			if remote then
				remote:FireServer()
				Library:Notify({ Title = "Rivo Hub", Content = "Room reset.", Duration = 3 })
			else
				Library:Notify({ Title = "Rivo Hub", Content = "Remote not found.", Duration = 3 })
			end
		end,
		Risky = true,
	})

	local UIGroup = Tabs["UI Settings"]:AddLeftGroupbox("Menu")

	UIGroup:AddToggle("KeybindMenuOpen", {
		Default = Library.KeybindFrame and Library.KeybindFrame.Visible or false,
		Text = "Open Keybind Menu",
		Callback = function(v)
			if Library.KeybindFrame then
				Library.KeybindFrame.Visible = v
			end
		end,
	})

	UIGroup:AddToggle("ShowCustomCursor", {
		Text = "Custom Cursor",
		Default = true,
		Callback = function(v)
			Library.ShowCustomCursor = v
		end,
	})

	UIGroup:AddDropdown("NotifSide", {
		Values = { "Left", "Right" },
		Default = "Right",
		Text = "Notification Side",
		Callback = function(v)
			Library:SetNotifySide(v)
		end,
	})

	UIGroup:AddDropdown("DPIScale", {
		Values = { "50%", "75%", "100%", "125%", "150%", "175%", "200%" },
		Default = "100%",
		Text = "DPI Scale",
		Callback = function(v)
			v = v:gsub("%%", "")
			Library:SetDPIScale(tonumber(v))
		end,
	})

	UIGroup:AddDivider()

	UIGroup:AddLabel("Menu Bind"):AddKeyPicker("MenuKeybind", { Default = "RightShift", NoUI = true, Text = "Menu keybind" })

	local DiscordSettingsGroup = Tabs["UI Settings"]:AddRightGroupbox("Links")

	DiscordSettingsGroup:AddButton({
		Text = "Join Discord",
		Func = function()
			Library:Notify({ Title = "Rivo Hub", Content = "discord.gg/ZN4jtyPNHG", Duration = 6 })
		end,
	})

	DiscordSettingsGroup:AddLabel("discord.gg/ZN4jtyPNHG")
	DiscordSettingsGroup:AddLabel("Key: kairon-script")

	UIGroup:AddButton("Unload", function()
		Library:Unload()
	end)

	Library.ToggleKeybind = Options.MenuKeybind

	ThemeManager:SetLibrary(Library)
	SaveManager:SetLibrary(Library)
	SaveManager:IgnoreThemeSettings()
	SaveManager:SetIgnoreIndexes({ "MenuKeybind" })
	ThemeManager:SetFolder("RivoHub")
	SaveManager:SetFolder("RivoHub/saves")
	SaveManager:BuildConfigSection(Tabs["UI Settings"])
	ThemeManager:ApplyToTab(Tabs["UI Settings"])
	SaveManager:LoadAutoloadConfig()

	Library:Notify({ Title = "Rivo Hub", Content = "Authorized. Welcome.", Duration = 4 })

end
