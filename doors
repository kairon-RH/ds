	local function teleportToRoom(room)
		local currentRooms = workspace:FindFirstChild("CurrentRooms")
		if not currentRooms then
			Library:Notify({ Title = "Rivo Hub", Content = "CurrentRooms not found.", Duration = 3 })
			return
		end
		local roomModel = currentRooms:FindFirstChild(tostring(room))
		if roomModel then
			local door = roomModel:FindFirstChild("Door", true)
			if door then
				rootPart.CFrame = door.CFrame + Vector3.new(0, 3, 0)
			else
				rootPart.CFrame = roomModel:GetModelCFrame() + Vector3.new(0, 5, 0)
			end
			Library:Notify({ Title = "Rivo Hub", Content = "Teleported to Room " .. room, Duration = 3 })
		else
			Library:Notify({ Title = "Rivo Hub", Content = "Room " .. room .. " not found.", Duration = 3 })
		end
	end

