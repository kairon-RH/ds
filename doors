	local function clearESP()
		for _, obj in pairs(espObjects) do
			if obj and obj.Parent then obj:Destroy() end
		end
		espObjects = {}
	end

	local function buildESP(target)
		if not target or not target:FindFirstChild("HumanoidRootPart") then return end
		local existing = espObjects[target]
		if existing and existing.Parent then return end

		local highlight = Instance.new("Highlight")
		highlight.Adornee = target
		highlight.FillColor = Color3.fromRGB(160, 100, 255)
		highlight.OutlineColor = Color3.fromRGB(220, 180, 255)
		highlight.FillTransparency = 0.6
		highlight.OutlineTransparency = 0
		highlight.Parent = target
		espObjects[target] = highlight

		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromOffset(120, 40)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true
		billboard.Adornee = target.HumanoidRootPart
		billboard.Parent = target.HumanoidRootPart

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(220, 200, 255)
		label.TextSize = 13
		label.Font = Enum.Font.GothamBold
		label.TextStrokeTransparency = 0.4
		label.Parent = billboard

		espObjects[target .. "_bb"] = billboard

		RunService.Heartbeat:Connect(function()
			if not espEnabled then return end
			if not target or not target.Parent then return end
			local root = target:FindFirstChild("HumanoidRootPart")
			local myRoot = character and character:FindFirstChild("HumanoidRootPart")
			local dist = (root and myRoot) and math.floor((root.Position - myRoot.Position).Magnitude) or 0
			local name = target.Name
			local parts = {}
			if showNames then parts[#parts + 1] = name end
			if showDistance then parts[#parts + 1] = dist .. "m" end
			label.Text = table.concat(parts, " | ")
			label.Visible = showNames or showDistance
			highlight.Enabled = showHighlight
		end)
	end

	local function refreshESP()
		clearESP()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then
				buildESP(p.Character)
			end
		end
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("Model") and obj:FindFirstChild("Humanoid") then
				buildESP(obj)
			end
		end
	end

